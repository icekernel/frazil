#!/usr/bin/env python3
"""secrets - fail on secret-shaped text; prints path:line: rule, never the value.

tools/secrets              every file git tracks under cwd (the CI check `secrets`)
tools/secrets PATH...      these files; dirs are walked, .git skipped
tools/secrets --staged     the index version of each staged file (.githooks/pre-commit)

Exit 0 clean, 1 findings, 2 error. Binary files (a NUL byte) are skipped.
"""
import math
import os
import re
import subprocess
import sys
from collections import Counter

RULES = (
    ("github-token", re.compile(r"\bgh[opsur]_[A-Za-z0-9]{36,}")),
    ("github-pat", re.compile(r"\bgithub_pat_[A-Za-z0-9_]{22,}")),
    ("anthropic-key", re.compile(r"\bsk-ant-[A-Za-z0-9_-]{20,}")),
    ("aws-access-key-id", re.compile(r"\b(?:AKIA|ASIA)[A-Z0-9]{16}\b")),
    ("slack-token", re.compile(r"\bxox[abpr]-[A-Za-z0-9-]{10,}")),
    ("private-key", re.compile("-----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY(?: BLOCK)?-----")),
)
# a name ending in KEY, TOKEN, SECRET or PASSWORD, assigned a literal of 16+ chars
ASSIGN = re.compile(r"""[A-Za-z0-9_.-]*(?:key|token|secret|password)["']?\s*(?::=|=>|[:=])\s*"""
                    r"""["']?([A-Za-z0-9+/=_~-]{16,})""", re.I)
MIN_ENTROPY = 3.5  # bits per char; placeholders and identifiers score lower


def entropy(s):
    return -sum(k / len(s) * math.log2(k / len(s)) for k in Counter(s).values())


def high_entropy(v):
    if "/" in v and not any(c.isupper() for c in v):
        return False  # a path, e.g. a Terraform state key; base64 secrets carry uppercase
    return (MIN_ENTROPY <= entropy(v) and any(c.isdigit() for c in v)
            and any(c.isalpha() for c in v))


def scan(text):
    """Yield (line number, rule) per rule that fires on a line."""
    for i, line in enumerate(text.splitlines(), 1):
        for name, rx in RULES:
            if rx.search(line):
                yield i, name
        if any(high_entropy(m.group(1)) for m in ASSIGN.finditer(line)):
            yield i, "high-entropy-assignment"


def git(*args):
    r = subprocess.run(["git", *args], capture_output=True)
    if r.returncode:
        raise OSError(f"git {args[0]}: {r.stderr.decode(errors='replace').strip()}")
    return r.stdout


def read(p):
    with open(p, "rb") as f:
        return p, f.read()


def files(paths):
    """Yield (path, bytes) per named file and per regular file under a named dir."""
    for p in paths:
        if os.path.islink(p):
            continue
        if not os.path.isdir(p):
            yield read(p)
            continue
        for d, dirs, names in os.walk(p):
            dirs[:] = sorted(x for x in dirs if x != ".git")
            for q in (os.path.join(d, x) for x in sorted(names)):
                if os.path.isfile(q) and not os.path.islink(q):
                    yield read(q)


def staged():
    out = git("diff", "--cached", "--name-only", "-z", "--diff-filter=ACMR",
              "--ignore-submodules=all")
    for p in filter(None, os.fsdecode(out).split("\0")):
        yield p, git("cat-file", "blob", f":{p}")


def tracked():
    out = git("ls-files", "-z")
    yield from files(p for p in os.fsdecode(out).split("\0") if os.path.isfile(p))


def main(argv):
    if argv == ["--staged"]:
        blobs = staged()
    elif argv[:1] and argv[0].startswith("-"):
        print(__doc__, file=sys.stderr)
        return 2
    else:
        blobs = files(argv) if argv else tracked()
    count = found = 0
    try:
        for path, data in blobs:
            count += 1
            if b"\0" in data[:8192]:
                continue
            for i, rule in scan(data.decode("utf-8", "replace")):
                found += 1
                print(f"{path}:{i}: {rule}")
    except OSError as e:
        print(f"secrets: {e}", file=sys.stderr)
        return 2
    print(f"secrets: {count} files, {found} findings", file=sys.stderr)
    return 1 if found else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
